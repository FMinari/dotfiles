// Boas-vindas do terminal (roda ao abrir o fish). Docs: fastfetch --help-config
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "cachyos_small",
    "color": { "1": "red", "2": "yellow" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "yellow" },
    "key": { "width": 5 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    { "type": "custom", "format": "{#red}───────────────────────────" },
    { "type": "os",       "key": " 󰣇" },
    { "type": "kernel",   "key": " " },
    { "type": "wm",       "key": " " },
    { "type": "packages", "key": " 󰏖" },
    { "type": "uptime",   "key": " 󰅐" },
    { "type": "memory",   "key": " 󰍛" },
    { "type": "battery",  "key": " 󰁹" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 5 }
  ]
}
