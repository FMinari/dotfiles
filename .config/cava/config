## cava — visualizador de música no terminal. Rode: cava  (q sai, setas mudam sensibilidade)
## As cores vêm do tema do Noctalia (arquivo themes/noctalia, gerado sozinho).

[general]
framerate = 60
autosens = 1
bars = 0            # 0 = automático pela largura do terminal
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average

[color]
theme = "noctalia"

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77
